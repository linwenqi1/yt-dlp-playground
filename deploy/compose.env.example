# Copy to deploy/compose.env (never commit it).
# YTP_* values are read by the backend container. Empty values fall back to defaults.

YTP_MAX_CONCURRENT_JOBS=1
YTP_MAX_QUEUED_JOBS=20
YTP_JOB_TTL_HOURS=24
YTP_MAX_FILESIZE_MB=2048
YTP_MAX_JOB_MINUTES=120
YTP_INFO_CACHE_TTL_SECONDS=600
YTP_INFO_CONCURRENCY=2
YTP_LOG_LEVEL=INFO

# Shared secret injected by the Pages Function. Set the SAME value as the
# Pages secret API_TOKEN. Empty disables the check — only acceptable for
# localhost experimentation; behind a Tunnel always set it.
# YTP_API_TOKEN=change-me

# Optional cookies (mounted from the host): uncomment and add a bind mount in
# docker-compose.yml, or copy the file into the container.
# YTP_COOKIES_FILE=/data/cookies.txt
# YTP_PROXY=http://host.docker.internal:7890
# YTP_IMPERSONATE=chrome

# Cloudflare Tunnel token (only needed with `--profile tunnel`).
# TUNNEL_TOKEN=
