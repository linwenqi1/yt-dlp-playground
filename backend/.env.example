# 本地开发配置；复制为 .env 后按需修改。所有变量都有默认值。
YTP_DATA_DIR=./data
YTP_MAX_CONCURRENT_JOBS=1
YTP_MAX_QUEUED_JOBS=20
YTP_JOB_TTL_HOURS=24
YTP_MAX_FILESIZE_MB=2048
YTP_MAX_JOB_MINUTES=120
YTP_INFO_CACHE_TTL_SECONDS=600
YTP_INFO_CONCURRENCY=2
YTP_LOG_LEVEL=INFO

# 可选：cookies.txt（浏览器导出），用于登录态/风控较严的视频
# YTP_COOKIES_FILE=/path/to/cookies.txt
# 可选：HTTP 代理，例如 http://127.0.0.1:7890
# YTP_PROXY=
# 可选：TLS 指纹模拟（需要 curl-cffi），例如 chrome
# YTP_IMPERSONATE=
# 可选：共享 API token；为空表示关闭校验（本地默认）
# YTP_API_TOKEN=
